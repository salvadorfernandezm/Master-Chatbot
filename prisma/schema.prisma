generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                    String   @id @default(cuid())
  organizationName      String   @default("Master Chatbot IA")
  organizationLogo      String?
  defaultWelcomeMessage String   @default("¡Hola! Soy el asistente del profesor y estoy aquí para ayudarte.")
  timezone              String   @default("UTC")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
organizationBuzonInfo String? @db.Text
isBuzonActive         Boolean @default(true)
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chatbots    Chatbot[]
}

model KnowledgeBase {
  id          String     @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  chatbots    Chatbot[]
  documents   Document[]
}

model Document {
  id              String          @id @default(cuid())
  filename        String
  type            String
  urlOrPath       String?
  knowledgeBaseId String
  createdAt       DateTime        @default(now())
  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]
}

model DocumentChunk {
  id              String   @id @default(cuid())
  content         String
  metadata        String
  embedding       String?
  documentId      String
  knowledgeBaseId String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Chatbot {
  id                 String   @id @default(cuid())
  name               String
  token              String   @unique
  groupId            String
  knowledgeBaseId    String
  isActive           Boolean  @default(true)
  welcomeMessage     String?
  infoMessage        String?  // Esta es tu nueva ocurrencia del botón de info
  systemInstructions String?
  fallbackMessage    String?
  inputPlaceholder   String?
  logoUrl            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // RELACIONES
  group         Group         @relation(fields: [groupId], references: [id])
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])
  interactions  Interaction[] // <--- ESTA ES LA LÍNEA QUE FALTA PARA QUE EL ERROR SE VAYA
}

model Interaction {
  id        String   @id @default(cuid())
  chatbotId String
  query     String
  response  String
  createdAt DateTime @default(now())
  chatbot   Chatbot  @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
}

// Modelo para el Buzón Inteligente
model Ticket {
  id              String   @id @default(cuid())
  folio           String   @unique // El código secreto (ej: "Z-1234")
  type            String   
  content         String   
  studentName     String?  
  status          String   @default("PENDIENTE") 
  
  // NUEVOS CAMPOS PARA LA "VEZ" DEL ALUMNO:
  authorityResponse String?  // Lo que la autoridad le contesta al alumno
  studentResolved  Boolean  @default(false) // Si el alumno dio el visto bueno
  
  createdAt       DateTime @default(now())
}